# =============================================================================
# masops-evaluation — environment configuration template
# Copy this file to `.env` and fill in the values below.
# =============================================================================

# -----------------------------------------------------------------------------
# MAS-Ops endpoint (the EC2 running the multi-agent system in evaluation mode)
# -----------------------------------------------------------------------------

# Private VPC IP of EC2-mas-ops (e.g. 10.0.1.42). Do NOT use a public IP.
MASOPS_HOST=

# Port exposed by the MAS-Ops evaluation API.
MASOPS_PORT=8000

# HTTP timeout in seconds for /eval/pr-review requests.
# Generous default: clone-on-demand of large repos (Django, etc.) can take a while.
MASOPS_TIMEOUT=1200

# Path of the MAS-Ops health endpoint, used for the pre-flight check.
MASOPS_HEALTH_PATH=/health

# -----------------------------------------------------------------------------
# SWE-bench dataset / harness
# -----------------------------------------------------------------------------

# Hugging Face dataset identifier.
SWEBENCH_DATASET=princeton-nlp/SWE-bench_Verified

# Prefix used when building run_ids passed to the SWE-bench harness.
# Final run_id pattern: {prefix}-{rodada_id}-{instance_id}-{suffix}
SWEBENCH_HARNESS_RUN_ID_PREFIX=eval

# -----------------------------------------------------------------------------
# LLM for qualitative narrative in the aggregator (OPTIONAL)
# -----------------------------------------------------------------------------

# Optional. Only needed if you want aggregate-results to produce the
# LLM-generated narrative sections (executive summary, qualitative
# observations, notable cases). Leave empty to skip — the aggregator will
# render those sections as placeholder strings and continue normally.
# Also requires the `anthropic` package: pip install -e ".[narrative]"
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Langfuse — end-to-end token accounting (OPTIONAL)
# -----------------------------------------------------------------------------

# Langfuse runs alongside MAS-Ops on EC2-mas-ops, port 3000. When this is
# left empty the aggregator derives `http://{MASOPS_HOST}:3000` automatically;
# set it explicitly only if Langfuse lives somewhere else.
LANGFUSE_URL=

# Basic Auth credentials for the Langfuse public API. Leave both empty to
# skip Langfuse — the aggregator falls back to the partial estimate based on
# `tokens_by_agent` (which excludes Executor and Communicator).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Project identifier used for logging context. Default matches the
# project name configured on EC2-mas-ops.
LANGFUSE_PROJECT_ID=masops-project

# -----------------------------------------------------------------------------
# Local paths
# -----------------------------------------------------------------------------

# Per-execution JSON records land in {RESULTS_DIR}/{rodada_id}/.
RESULTS_DIR=./results

# Consolidated reports and charts land in {CONSOLIDATED_DIR}/{rodada_id}/.
CONSOLIDATED_DIR=./consolidated

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Standard Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
